# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  CLYON — variáveis de ambiente                                           ║
# ╚══════════════════════════════════════════════════════════════════════════╝
#
# Este ficheiro é a LISTA COMPLETA do que o código lê, e nada mais. Foi
# reescrito a partir de um `grep` a todos os `process.env.` de src/, scripts/
# e ponte-whatsapp/, porque a versão anterior omitia 34 variáveis e declarava
# 6 que ninguém usava — e uma variável em falta aqui não dá erro nenhum: dá
# um comportamento silenciosamente errado, que foi o que aconteceu com o
# JWT_SECRET num ambiente de pré-visualização.
#
# Copiar para `.env.local` e preencher. O que ficar vazio degrada a
# funcionalidade correspondente; onde isso for perigoso, está dito.


# ── Base de dados ────────────────────────────────────────────────────────────
# MySQL no Railway. Sem isto o site arranca mas não guarda nem lê nada.
DATABASE_URL=

# ── Sessões e contas ─────────────────────────────────────────────────────────
# Assina os cookies de sessão do backoffice e dos profissionais.
# Gerar com: openssl rand -base64 32
JWT_SECRET=
# Do next-auth (entrada com Google). Gerar da mesma maneira.
NEXTAUTH_SECRET=
# O endereço público, lido pelo next-auth para montar os retornos do OAuth.
# Em produção na Vercel pode ficar vazio; localmente é http://localhost:3000
NEXTAUTH_URL=
# Entrada com Google no backoffice.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# O openId da conta do dono: distingue-o dos restantes colaboradores.
OWNER_OPEN_ID=

# ── Contas de arranque do backoffice ─────────────────────────────────────────
# Criadas uma vez pela rota de setup. Depois disto, mudam-se no painel.
ADMIN_NOME=
ADMIN_SENHA=
ASSISTENTE1_SENHA=
ASSISTENTE2_SENHA=
# Protege a rota /api/admin/setup. Sem isto a rota recusa-se a correr.
ADMIN_SETUP_SECRET=

# ── Portão do MVP ────────────────────────────────────────────────────────────
# A chave que abre as páginas fechadas enquanto o site não é público.
CHAVE_MVP=

# ── Endereço do site ─────────────────────────────────────────────────────────
# Usado nos emails, nos links do WhatsApp e nos schemas. Sem barra no fim.
NEXT_PUBLIC_SITE_URL=https://clyon.pt
SITE_URL=https://clyon.pt

# ── Google Maps ──────────────────────────────────────────────────────────────
# Do lado do servidor: geocodificação de moradas e distâncias reais.
GOOGLE_MAPS_SERVER_API_KEY=
GOOGLE_MAPS_API_KEY=
# Do lado do browser: o autocomplete de morada. Restringir por domínio na
# consola do Google — esta chave vai no HTML e vê-se.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Nome antigo da mesma chave do browser, ainda aceite como recurso.
NEXT_PUBLIC_FRONTEND_FORGE_API_KEY=

# ── Base de onde se medem distâncias no backoffice ───────────────────────────
# A CLYON é uma plataforma: quem tem base é o profissional, e é da base DELE
# que se mede o que lhe interessa. Isto serve só as estimativas do backoffice
# quando ainda não há profissional escolhido.
CLYON_BASE_ADDRESS=
CLYON_BASE_LAT=
CLYON_BASE_LNG=

# ── Google Calendar e Sheets ─────────────────────────────────────────────────
# Conta de serviço criada na Google Cloud Console. A chave privada vai entre
# aspas e com os \n literais.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
CLYON_GOOGLE_CALENDAR_ID=
CLYON_GOOGLE_CALENDAR_NAME=
GOOGLE_SHEETS_SPREADSHEET_ID=

# ── Gemini (inteligência artificial) ─────────────────────────────────────────
# Nunca com NEXT_PUBLIC_: uma chave de IA no browser é uma conta aberta.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Modelo do chat do simulador.
CHAT_MODEL=

# ── Email (Resend) ───────────────────────────────────────────────────────────
# O nome com sufixo é o que a maioria das rotas lê; o outro é o recurso.
RESEND_API_KEY_clyonsite=
RESEND_API_KEY=

# ── Supabase (a app dos profissionais) ───────────────────────────────────────
# Só de leitura do lado do site. A service role NUNCA vai para o browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Ficheiros (Vercel Blob) ──────────────────────────────────────────────────
# Fotografias dos pedidos e provas de trabalho feito.
BLOB_READ_WRITE_TOKEN=

# ── Limite de pedidos (Upstash / Vercel KV) ──────────────────────────────────
# Sem isto o limite passa a ser por instância e deixa passar em caso de falha.
# Confirmar que está ligado em produção.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Avisos no telemóvel (Web Push) ───────────────────────────────────────────
# Gerar o par com: npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# mailto: com um endereço a sério — os servidores de push exigem-no.
VAPID_SUBJECT=

# ── WhatsApp — API oficial da Meta ───────────────────────────────────────────
# Quando existir. Enquanto não existir, fica tudo vazio e o site usa a ponte.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO_NUMBER=
# Confirma o webhook e assina o que chega da Meta.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ── WhatsApp — sem API ───────────────────────────────────────────────────────
# O número da CLYON, para o caminho à mão do painel. "off" desliga-o.
WHATSAPP_NUMERO_MANUAL=
# O segredo partilhado com a ponte (ponte-whatsapp/). Sem ele a rota da
# ponte responde 503 e nada entra nem sai por lá.
PONTE_WHATSAPP_SEGREDO=

# ── Tarefas automáticas ──────────────────────────────────────────────────────
# Protege as rotas de cron. Comparado em tempo constante.
CRON_SECRET=

# ── Só para scripts locais ───────────────────────────────────────────────────
# scripts/set-provider-password.mjs
PROVIDER_SLUG=
PROVIDER_PASSWORD=


# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  A PONTE DO WHATSAPP — serviço à parte, no Railway                       ║
# ╚══════════════════════════════════════════════════════════════════════════╝
# Estas NÃO pertencem ao .env.local do site. Vão nas variáveis do serviço da
# ponte, e estão aqui só para ficarem escritas num sítio só.
#
#   SITE_URL                 https://clyon.pt
#   PONTE_WHATSAPP_SEGREDO   o mesmo valor que está em cima
#   PONTE_NUMERO             351931632622 — emparelha por código em vez de QR
#   VERSAO_DA_PAGINA         vazio = a versão actual do WhatsApp Web; põe-se
#                            uma anterior quando a nova parte as fotografias
#   CHROME_PATH              /usr/bin/chromium na imagem
#   INTERVALO_MS             de quanto em quanto tempo vai buscar a fila (5000)
#   PASTA_DA_SESSAO          /app/auth — tem de ser um volume montado


# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  Postas pela plataforma — não preencher                                  ║
# ╚══════════════════════════════════════════════════════════════════════════╝
# NODE_ENV, NEXT_RUNTIME, PORT, TZ, VERCEL_ENV, VERCEL_URL, VERCEL_BRANCH_URL
# são postas pelo Next e pela Vercel. O código lê-as; ninguém as escreve.
