{
  "expo": {
    "name": "CLYON",
    "slug": "clyon-cliente",
    "scheme": "clyoncliente",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "pt.clyon.cliente",
      "supportsTablet": false,
      "associatedDomains": [
        "applinks:clyon.pt"
      ]
    },
    "android": {
      "package": "pt.clyon.cliente",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "clyon.pt",
              "path": "/entrar/app"
            },
            {
              "scheme": "https",
              "host": "clyon.pt",
              "pathPrefix": "/pedido/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0A7C87"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "A CLYON usa a câmara para tirar fotografias do que precisa de levar.",
          "photosPermission": "A CLYON usa as fotografias que escolher para as juntar ao pedido.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-web-browser",
      "expo-font",
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "site": "https://clyon.pt",
      "router": {},
      "eas": {
        "projectId": "e4e2f70f-675b-4085-869b-232701245328"
      }
    },
    "owner": "wandersonclyon",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/e4e2f70f-675b-4085-869b-232701245328",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
