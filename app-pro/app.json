{
  "expo": {
    "name": "CLYON Pro",
    "slug": "clyon-pro",
    "scheme": "clyonpro",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "pt.clyon.pro",
      "supportsTablet": false,
      "associatedDomains": [
        "applinks:clyon.pt",
        "webcredentials:clyon.pt"
      ]
    },
    "android": {
      "package": "pt.clyon.pro",
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "clyon.pt",
              "pathPrefix": "/profissionais/painel"
            },
            {
              "scheme": "https",
              "host": "clyon.pt",
              "pathPrefix": "/profissionais/pedidos/"
            },
            {
              "scheme": "https",
              "host": "clyon.pt",
              "pathPrefix": "/profissionais/definir-senha/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0A7C87"
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "A CLYON Pro usa a câmara para fotografar o trabalho: o que encontrou no local e o trabalho feito.",
          "photosPermission": "A CLYON Pro abre as suas fotografias para escolher as do trabalho.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0F172A"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "site": "https://clyon.pt",
      "router": {},
      "eas": {
        "projectId": "e608da71-aef3-4959-a55b-56230aee7345"
      }
    },
    "owner": "wandersonclyon"
  }
}
