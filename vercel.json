{
  "regions": [
    "sin1"
  ],
  "functions": {
    "src/app/api/address/**/route.ts": {
      "regions": [
        "iad1"
      ]
    },
    "src/app/api/blob/**/route.ts": {
      "regions": [
        "iad1"
      ]
    },
    "src/app/api/location/**/route.ts": {
      "regions": [
        "iad1"
      ]
    },
    "src/app/api/maps/**/route.ts": {
      "regions": [
        "iad1"
      ]
    }
  },
  "crons": [
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/cron/libertar-por-prazo",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/purgar-pedidos",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/cron/assistente",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/alcancar-pedidos",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/cron/conferir-pagamentos",
      "schedule": "45 * * * *"
    }
  ]
}
